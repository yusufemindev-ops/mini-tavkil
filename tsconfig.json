{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/server/*": ["./apps/api/src/*"],
      "@/*": ["./apps/storefront/src/*"],
      "@tavkil/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "vitest.setup.ts",
    "apps/storefront/next-env.d.ts",
    "apps/storefront/src/**/*.ts",
    "apps/storefront/src/**/*.tsx",
    "apps/api/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "apps/storefront/.next/types/**/*.ts",
    "apps/storefront/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/admin", "apps/storefront/public", "apps/storefront/worker.ts"]
}
