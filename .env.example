# mini-tavkil — environment
#
# Local dev:  copy to `.env`
# Cloudflare local (wrangler):  copy to `.dev.vars`
# Production:  `wrangler secret put <NAME>` — never commit real values
#
# Values marked [carry] can be copied straight from tavkil's .env.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tavkil.com
# Set false on preview deploys so they emit noindex + robots deny.
SITE_INDEXABLE=false

# ─── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled HTTP connection — used at runtime by @prisma/adapter-neon.
# HTTP (not WebSocket) so Neon compute autosuspends and free CU-hours last.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct connection — used by `prisma migrate` and seed/sync scripts only.
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── Auth (Better Auth + Google, admin only) ─────────────────────────────────
BETTER_AUTH_SECRET=            # [carry]
BETTER_AUTH_URL=https://tavkil.com
GOOGLE_CLIENT_ID=              # [carry]
GOOGLE_CLIENT_SECRET=          # [carry]
# Comma-separated emails allowed into /admin.
ADMIN_ALLOWLIST=               # [carry]

# ─── Media (Cloudflare R2) ───────────────────────────────────────────────────
# No S3 keys: the bucket is a Worker binding in wrangler.jsonc.
# Only the public read URL is needed here.
NEXT_PUBLIC_R2_PUBLIC_URL=https://images.tavkil.com
MAX_UPLOAD_MB=10

# ─── Contact form ────────────────────────────────────────────────────────────
# The only public write, and the only conversion path — there is no cart or login.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Email sender: TBD. Postmark was dropped — it made sense for Tavkil on generic
# hosting, but on Cloudflare, Email Service sends from a Worker binding with no
# API token, no separate account, and no bill. Decide when the form is built.

# ─── SEO ─────────────────────────────────────────────────────────────────────
INDEXNOW_API_KEY=                 # [carry]

# ─── Dropped from tavkil — do not re-add ─────────────────────────────────────
# PORT, WORKER_MODE, NODE_ENV       → no Nest server; Workers has no boot
# POSTMARK_*                        → Cloudflare Email Service instead; decided 2026-08-10
# CORS_ALLOWED_ORIGINS              → same-origin; storefront + admin + API in one app
# S3_*                              → R2 Worker binding replaces them
# VITE_*                            → admin is served same-origin, API base is "/api"
# *_API_MOCKING, *_MOCK_DELAY_MS    → MSW dropped
# RATE_LIMIT_*                      → Cloudflare WAF / rate-limiting rules instead
# OTEL_*, SENTRY_DSN, HONEYCOMB_*   → Workers Observability first; revisit later
# WORKER_POLL_INTERVAL_MS           → FX runs on a Cron Trigger, not a poll loop
