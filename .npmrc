# pnpm configuration
auto-install-peers=true
strict-peer-dependencies=false

# Hoist common tooling so editors and admin workspace resolve them cleanly
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*
public-hoist-pattern[]=@tailwindcss/*

# Engine strictness — prevent installs on wrong Node/pnpm versions
engine-strict=true
