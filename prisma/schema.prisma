// Cloudflare Workers requires the `prisma-client` generator (not `prisma-client-js`).
// Prisma 7 is Rust-free; the client runs on Workers via @prisma/adapter-neon over HTTP.
// See .claude/skills/cloudflare-constraints.md
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma.config.ts — Prisma 7 no longer accepts them here.
datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth) ──────────────────────────────────────────────────────

model AuthUser {
  id                    String               @id
  name                  String
  email                 String
  emailVerified         Boolean              @default(false)
  image                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  role                  String?
  banned                Boolean?             @default(false)
  banReason             String?
  banExpires            DateTime?
  userType              String?              @default("buyer")
  authsessions          AuthSession[]
  authaccounts          AuthAccount[]
  auth_user_roles       AuthUserRole[]
  buyer_profile         BuyerProfile?
  profile_edit_requests ProfileEditRequest[]
  orders_as_buyer       OrderRequest[]       @relation("BuyerOrders")
  orders_confirmed      OrderRequest[]       @relation("ConfirmedOrders")
  orders_assigned       OrderRequest[]       @relation("AssignedOrders")

  companyName     String?
  contactName     String?
  firstName       String?
  lastName        String?
  jobTitle        String?
  phone           String?
  country         String?
  city            String?
  address         String?
  // Admin-vetted trust flag (buyer-visible). New buyers start unverified; an
  // admin flips this after manually verifying them. Orthogonal to `banned`.
  verified        Boolean?  @default(false)
  // Last authenticated activity (heartbeat), for the admin online/last-seen column.
  lastSeenAt      DateTime?
  preferredLocale String?   @default("en")

  @@unique([email])
  @@map("authUser")
}

// Commercial / admin-only data for buyer authUsers. Kept OFF authUser so it never
// reaches the buyer's Better Auth session — `tier_markup_percent` is a
// pricing-visibility-restricted field and `notes` is internal.
model BuyerProfile {
  auth_user_id        String   @id
  tier_markup_percent Decimal  @default(0) @db.Decimal(5, 2)
  notes               String?
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  auth_user AuthUser @relation(fields: [auth_user_id], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

// A buyer's proposed profile change, awaiting admin review. Buyers can't edit
// their profile directly — they submit one of these. At most one pending row per
// buyer (the buyer submit upserts the pending one). On approve, the proposed_*
// values are applied to the buyer's authUser. Phone is stored E.164.
model ProfileEditRequest {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id             String
  proposed_first_name      String?
  proposed_last_name       String?
  proposed_company         String?
  proposed_phone           String?
  proposed_job_title       String?
  proposed_country         String?   @db.Char(2)
  proposed_city            String?
  proposed_address         String?
  status                   String    @default("pending")
  reviewed_by_auth_user_id String?
  reviewed_at              DateTime? @db.Timestamptz(3)
  rejection_reason         String?
  created_at               DateTime  @default(now()) @db.Timestamptz(3)
  updated_at               DateTime  @updatedAt @db.Timestamptz(3)

  buyer AuthUser @relation(fields: [auth_user_id], references: [id], onDelete: Cascade)

  @@index([status], map: "profile_edit_requests_status_idx")
  @@index([auth_user_id], map: "profile_edit_requests_buyer_idx")
  @@map("profile_edit_requests")
}

model AuthSession {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  authuser       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("authSession")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("authAccount")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("authVerification")
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  role_permissions RolePermission[]
  auth_user_roles  AuthUserRole[]

  @@index([code], map: "roles_code_idx")
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  domain      String
  name        String
  description String?
  deprecated  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  role_permissions RolePermission[]

  @@index([domain], map: "permissions_domain_idx")
  @@map("permissions")
}

model RolePermission {
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  granted_at    DateTime @default(now()) @db.Timestamptz(3)
  // Text (no FK): holds the granting authUser id (Better Auth ids are non-uuid).
  granted_by    String?

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([role_id], map: "role_permissions_role_idx")
  @@map("role_permissions")
}

model AuthUserRole {
  auth_user_id String
  role_id      String   @db.Uuid
  assigned_at  DateTime @default(now()) @db.Timestamptz(3)

  auth_user AuthUser @relation(fields: [auth_user_id], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([auth_user_id, role_id])
  @@index([auth_user_id], map: "auth_user_roles_user_idx")
  @@map("auth_user_roles")
}

// ─── Reference data ──────────────────────────────────────────────────────────

model Locale {
  code         String  @id
  name_english String
  name_native  String
  dir          String
  is_active    Boolean @default(true)
  is_default   Boolean @default(false)
  sort_order   Int     @default(0)

  account_requests      AccountRequest[]
  category_translations CategoryTranslation[]
  supplier_translations SupplierTranslation[]
  product_translations  ProductTranslation[]
  product_attributes    ProductAttribute[]
  order_requests        OrderRequest[]

  @@map("locales")
}

// ─── Intake ──────────────────────────────────────────────────────────────────

model AccountRequest {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name                 String
  last_name                  String
  business_email             String    @db.Citext
  phone                      String?
  job_title                  String?
  company                    String?
  company_website            String?
  country_code               String    @db.Char(2)
  city                       String?
  address                    String?
  intended_categories        Json      @default("[]")
  message                    String?
  locale                     String
  captcha_score              Decimal?  @db.Decimal(3, 2)
  ip_address                 String?   @db.Inet
  user_agent                 String?
  status                     String    @default("pending")
  // Better Auth user ids are non-uuid strings, so these are plain text (no FK)
  // — same decoupling we use on audit_log. They hold authUser ids.
  reviewed_by_auth_user_id   String?
  reviewed_at                DateTime? @db.Timestamptz(3)
  rejection_reason           String?
  created_buyer_auth_user_id String?
  created_at                 DateTime  @default(now()) @db.Timestamptz(3)

  locale_rel Locale @relation(fields: [locale], references: [code])

  @@index([status], map: "account_requests_status_idx")
  @@index([business_email], map: "account_requests_email_idx")
  @@map("account_requests")
}

// ─── Ops ─────────────────────────────────────────────────────────────────────

// actor_id / impersonator_user_id are plain text (no FK) — they may hold a Better
// Auth id (non-uuid). Row-level DELETE/UPDATE are revoked in migration SQL.

model AuditLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_type           String
  actor_id             String?
  auth_method          String?
  action               String
  resource_type        String
  resource_id          String?
  before_state         Json?
  after_state          Json?
  ip_address           String?  @db.Inet
  user_agent           String?
  impersonator_user_id String?
  created_at           DateTime @default(now()) @db.Timestamptz(3)

  @@index([resource_type, resource_id], map: "audit_log_resource_idx")
  @@index([actor_type, actor_id], map: "audit_log_actor_idx")
  @@index([created_at(sort: Desc)], map: "audit_log_created_at_idx")
  @@index([impersonator_user_id], map: "audit_log_impersonator_idx")
  @@map("audit_log")
}

model SystemSetting {
  key                String   @id
  value              Json
  description        String?
  // Text (no FK): holds the updating authUser id.
  updated_by_user_id String?
  updated_at         DateTime @default(now()) @db.Timestamptz(3)

  @@map("system_settings")
}

// ─── Catalog (TSC-50) ────────────────────────────────────────────────────────
// Per db-schema.md §6. Adapted to current reality: user-id refs are text (no FK,
// Better Auth ids); the shared `media` table is deferred (TSC-57) so images hold
// a plain URL. CHECK constraints / partial + FTS indexes are enforced at the
// service layer for now (added as a custom migration when search/perf needs them).

model Currency {
  code       String  @id @db.Char(3)
  name       String
  symbol     String
  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  products         Product[]
  variants         ProductVariant[]   @relation("VariantCurrency")
  orders_submitted OrderRequest[]     @relation("SubmittedCurrencyOrders")
  orders_confirmed OrderRequest[]     @relation("ConfirmedCurrencyOrders")
  order_items      OrderRequestItem[] @relation("ItemCurrency")
  fx_rate          FxRate?

  @@map("currencies")
}

// Per-currency conversion rate to USD, refreshed daily by a worker job from a
// trusted source (TCMB→TRY, ECB→EUR, SAMA→SAR, CBUAE→AED). The storefront reads
// from this cache — never the external API. Display-only: orders are always USD
// (PRD §8.4.1 "Pattern A"). rate_to_usd means "1 USD = rate_to_usd of this
// currency" (e.g. TRY ≈ 32.5); USD's own rate is 1.
model FxRate {
  currency_code String   @id @db.Char(3)
  rate_to_usd   Decimal  @db.Decimal(12, 6)
  fetched_at    DateTime @default(now()) @db.Timestamptz(3)
  source        String

  currency Currency @relation(fields: [currency_code], references: [code], onDelete: Cascade)

  @@map("fx_rates")
}

// Audit/monitoring log for the FX refresh worker: one row per attempt (daily +
// any retries). Surfaced read-only in admin Settings → Currencies so failures are
// visible. `status`: 'success' | 'failed'. `source`: which provider answered.
model FxRateRun {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ran_at DateTime @default(now()) @db.Timestamptz(3)
  status String
  source String?
  error  String?
  rates  Json?

  @@index([ran_at])
  @@map("fx_rate_runs")
}

model Category {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id     String?   @db.Uuid
  image_url     String?
  display_order Int       @default(0)
  status        String    @default("draft")
  // How this (sub-)category's products are ordered on the storefront:
  // manual | newest | price_asc | price_desc | name | moq. Featured products
  // (product.is_featured) always pin to the top regardless of strategy.
  sort_strategy String    @default("manual")
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at    DateTime? @db.Timestamptz(3)

  parent       Category?             @relation("CategoryTree", fields: [parent_id], references: [id])
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parent_id], map: "categories_parent_idx")
  @@index([status], map: "categories_status_idx")
  @@map("categories")
}

model CategoryTranslation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id           String  @db.Uuid
  locale                String
  name                  String
  description           String?
  slug                  String
  seo_title             String?
  seo_description       String?
  is_machine_translated Boolean @default(false)
  is_complete           Boolean @default(false)

  category  Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  localeRef Locale   @relation(fields: [locale], references: [code])

  @@unique([category_id, locale])
  @@unique([locale, slug])
  @@index([locale], map: "category_translations_locale_idx")
  @@map("category_translations")
}

model Supplier {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_code           String    @db.Char(2)
  logo_url               String?
  website                String?
  contact_email_internal String?
  contact_phone_internal String?
  is_verified            Boolean   @default(false)
  internal_notes         String?
  address                String?
  map_url                String?
  status                 String    @default("draft")
  created_at             DateTime  @default(now()) @db.Timestamptz(3)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at             DateTime? @db.Timestamptz(3)

  translations SupplierTranslation[]
  products     Product[]

  @@index([country_code], map: "suppliers_country_idx")
  @@index([status], map: "suppliers_status_idx")
  @@map("suppliers")
}

model SupplierTranslation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id           String  @db.Uuid
  locale                String
  name                  String
  description           String?
  slug                  String
  seo_title             String?
  seo_description       String?
  is_machine_translated Boolean @default(false)
  is_complete           Boolean @default(false)

  supplier  Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  localeRef Locale   @relation(fields: [locale], references: [code])

  @@unique([supplier_id, locale])
  @@unique([locale, slug])
  @@map("supplier_translations")
}

model Product {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable so a product can be saved as a DRAFT before a category/supplier/SKU
  // is chosen. The publish-gate enforces they're set before publishing.
  supplier_id           String?   @db.Uuid
  category_id           String?   @db.Uuid
  sku                   String?   @unique
  moq                   Int       @default(1)
  box_quantity          Int?
  // Items contained in one sellable unit (e.g. a 3-pack = 3). Null/1 = single
  // item. Displayed as "1 pack (3 pcs)" on the storefront.
  pack_size             Int?
  weight_kg             Decimal?  @db.Decimal(10, 3)
  cbm                   Decimal?  @db.Decimal(10, 4)
  unit                  String    @default("piece")
  hs_code               String?
  brand_name            String?
  country_of_origin     String?   @db.Char(2)
  gtin13                String?
  mpn                   String?
  base_price_amount     Decimal?  @db.Decimal(14, 4)
  base_price_currency   String?   @db.Char(3)
  base_price_updated_at DateTime? @db.Timestamptz(3)
  // Text (no FK): holds the authUser id that last set the base price.
  base_price_updated_by String?
  status                String    @default("draft")
  sort_order            Int       @default(0)
  // Pins this product to the top of its category on the storefront, ahead of the
  // category's sort strategy. The "featured / merchandised" set (kept small).
  is_featured           Boolean   @default(false)
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at            DateTime? @db.Timestamptz(3)

  supplier     Supplier?            @relation(fields: [supplier_id], references: [id])
  category     Category?            @relation(fields: [category_id], references: [id])
  currency     Currency?            @relation(fields: [base_price_currency], references: [code])
  translations ProductTranslation[]
  attributes   ProductAttribute[]
  images       ProductImage[]
  options      ProductOption[]
  variants     ProductVariant[]
  order_items  OrderRequestItem[]

  @@index([supplier_id], map: "products_supplier_idx")
  @@index([category_id], map: "products_category_idx")
  // Storefront/arrange ordering within a category: featured first, then sort_order.
  @@index([category_id, is_featured, sort_order], map: "products_category_order_idx")
  @@index([status], map: "products_status_idx")
  @@index([gtin13], map: "products_gtin13_idx")
  @@map("products")
}

model ProductTranslation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id            String  @db.Uuid
  locale                String
  name                  String
  description           String?
  specs_md              String?
  slug                  String
  seo_title             String?
  seo_description       String?
  is_machine_translated Boolean @default(false)
  is_complete           Boolean @default(false)

  product   Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  localeRef Locale  @relation(fields: [locale], references: [code])

  @@unique([product_id, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model ProductAttribute {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String @db.Uuid
  locale     String
  attr_name  String
  attr_value String
  sort_order Int    @default(0)

  product   Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  localeRef Locale  @relation(fields: [locale], references: [code])

  @@unique([product_id, locale, attr_name])
  @@index([product_id, locale, sort_order], map: "product_attributes_product_idx")
  @@map("product_attributes")
}

model ProductImage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String   @db.Uuid
  url              String
  alt_translations Json     @default("{}")
  is_primary       Boolean  @default(false)
  sort_order       Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id], map: "product_images_product_idx")
  @@map("product_images")
}

// Buyer-selectable option (e.g. Color, Thickness). Admin-defined name + display
// type. Selecting a value never changes price/SKU — it's recorded with the order
// request. Single-language for now (name/labels not translated).
model ProductOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String  @db.Uuid
  name       String
  // 'swatch' (image/colour tiles) | 'chip' (text)
  type       String  @default("chip")
  is_visible Boolean @default(true)
  sort_order Int     @default(0)

  product Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([product_id, sort_order], map: "product_options_product_idx")
  @@map("product_options")
}

model ProductOptionValue {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  option_id  String  @db.Uuid
  label      String
  image_url  String?
  color_hex  String? @db.VarChar(9)
  sort_order Int     @default(0)

  option         ProductOption               @relation(fields: [option_id], references: [id], onDelete: Cascade)
  variant_values ProductVariantOptionValue[]

  @@index([option_id, sort_order], map: "product_option_values_option_idx")
  @@map("product_option_values")
}

// A concrete, purchasable variant of a product = one combination of option
// values (TSC-64). PRICE / SKU / MOQ live here, not on the product — a "simple"
// product is just a product with one default variant. This is the priced-variant
// model (length/size/colour each with its own price), replacing display-only
// options where a value never changed price.
model ProductVariant {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id            String    @db.Uuid
  sku                   String?   @unique
  base_price_amount     Decimal?  @db.Decimal(14, 4)
  base_price_currency   String?   @db.Char(3)
  base_price_updated_at DateTime? @db.Timestamptz(3)
  // Text (no FK): the authUser id that last set this variant's base price.
  base_price_updated_by String?
  moq                   Int       @default(1)
  pack_size             Int?
  weight_kg             Decimal?  @db.Decimal(10, 3)
  image_url             String?
  // Exactly one default variant per product — shown before the buyer picks
  // options, and the sole variant of a simple product.
  is_default            Boolean   @default(false)
  is_active             Boolean   @default(true)
  sort_order            Int       @default(0)
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  product       Product                     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  currency      Currency?                   @relation("VariantCurrency", fields: [base_price_currency], references: [code])
  option_values ProductVariantOptionValue[]

  @@index([product_id, sort_order], map: "product_variants_product_idx")
  @@map("product_variants")
}

// Join: the option values that define a variant (one per option axis). A 6m/Pink
// variant links the "6m" and "Pink" values.
model ProductVariantOptionValue {
  variant_id      String @db.Uuid
  option_value_id String @db.Uuid

  variant ProductVariant     @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  value   ProductOptionValue @relation(fields: [option_value_id], references: [id], onDelete: Cascade)

  @@id([variant_id, option_value_id])
  @@index([option_value_id], map: "pvov_value_idx")
  @@map("product_variant_option_values")
}

// ─── Orders (buyer request lifecycle) ────────────────────────────────────────
// Buyer submits a cart as an order REQUEST; an admin confirms it with final
// pricing; the buyer then accepts or rejects. Stale orders auto-expire. Prices
// are snapshotted at submit (legible even if the catalog changes). One currency
// per order (submitted_currency); the catalog is multi-currency so each line also
// carries its currency. See db-schema.md v0.6 §9. (Auth was migrated to Better
// Auth after that doc, so buyer/admin FKs point at authUser, not the old
// buyer_accounts/users tables.)

model OrderRequest {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number                  String    @unique
  buyer_id                      String
  locale                        String
  status                        String    @default("submitted")
  // Snapshots — what the buyer saw at submission.
  tier_markup_percent_at_submit Decimal   @db.Decimal(5, 2)
  submitted_subtotal_amount     Decimal   @db.Decimal(14, 4)
  submitted_currency            String    @db.Char(3)
  // Admin-confirmed values (set when an operator clicks Confirm).
  confirmed_markup_percent      Decimal?  @db.Decimal(5, 2)
  confirmed_subtotal_amount     Decimal?  @db.Decimal(14, 4)
  confirmed_grand_total_amount  Decimal?  @db.Decimal(14, 4)
  confirmed_currency            String?   @db.Char(3)
  confirmed_at                  DateTime? @db.Timestamptz(3)
  confirmed_by_user_id          String?
  // Notes & ops.
  notes_buyer                   String?
  notes_admin                   String?
  rejection_reason              String?
  assigned_user_id              String?
  // Lifecycle timestamps.
  submitted_at                  DateTime  @default(now()) @db.Timestamptz(3)
  accepted_at                   DateTime? @db.Timestamptz(3)
  rejected_at                   DateTime? @db.Timestamptz(3)
  expired_at                    DateTime? @db.Timestamptz(3)
  created_at                    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at                    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deleted_at                    DateTime? @db.Timestamptz(3)

  buyer          AuthUser           @relation("BuyerOrders", fields: [buyer_id], references: [id])
  confirmed_by   AuthUser?          @relation("ConfirmedOrders", fields: [confirmed_by_user_id], references: [id])
  assigned_to    AuthUser?          @relation("AssignedOrders", fields: [assigned_user_id], references: [id])
  locale_ref     Locale             @relation(fields: [locale], references: [code])
  submitted_curr Currency           @relation("SubmittedCurrencyOrders", fields: [submitted_currency], references: [code])
  confirmed_curr Currency?          @relation("ConfirmedCurrencyOrders", fields: [confirmed_currency], references: [code])
  items          OrderRequestItem[]

  @@index([buyer_id], map: "order_requests_buyer_idx")
  @@index([status], map: "order_requests_status_idx")
  @@index([assigned_user_id], map: "order_requests_assigned_idx")
  @@index([submitted_at(sort: Desc)], map: "order_requests_submitted_at_idx")
  @@map("order_requests")
}

model OrderRequestItem {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_request_id           String   @db.Uuid
  product_id                 String   @db.Uuid
  // Snapshots so the request stays legible even if the catalog changes later.
  product_name_snapshot      String
  product_image_url_snapshot String?
  product_unit_snapshot      String
  product_moq_snapshot       Int
  // The buyer's selected variant options at submit, e.g. [{"name":"Colour",
  // "value":"Pink"}]. Snapshotted so the order stays legible if options change.
  selected_options           Json?
  quantity                   Int
  // Pricing: set at submission, refined by admin pre-confirm, frozen post-confirm.
  unit_price_base            Decimal  @db.Decimal(14, 4)
  unit_price_final           Decimal? @db.Decimal(14, 4)
  line_subtotal              Decimal? @db.Decimal(14, 4)
  // The buyer's per-unit price at submit (base × (1 + tier%)). Immutable — kept
  // so the buyer can see how the admin's confirmed price compares to what they
  // originally requested, even after `unit_price_base` is edited on confirm.
  submitted_unit_price       Decimal? @db.Decimal(14, 4)
  currency                   String   @db.Char(3)
  buyer_note                 String?
  sort_order                 Int      @default(0)
  created_at                 DateTime @default(now()) @db.Timestamptz(3)
  updated_at                 DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  order_request OrderRequest @relation(fields: [order_request_id], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [product_id], references: [id])
  currency_ref  Currency     @relation("ItemCurrency", fields: [currency], references: [code])

  @@index([order_request_id], map: "order_request_items_request_idx")
  @@map("order_request_items")
}

// Per-year 4-digit order-number counter. Advanced by the next_order_number() SQL
// function (added in the migration), used on order insert → 'O-YYYY-NNNN'.
model OrderNumberSequence {
  year        Int @id
  last_number Int @default(0)

  @@map("order_number_sequence")
}
