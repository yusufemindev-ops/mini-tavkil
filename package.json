{
  "name": "mini-tavkil",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-banner.mjs && pnpm run --stream \"/^dev:/\"",
    "dev:next": "next dev",
    "dev:admin": "pnpm --filter mini-tavkil-admin dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "bash scripts/check-locale-parity.sh",
    "check:pricing-leak": "bash scripts/check-pricing-leak.sh",
    "scan": "tsx scripts/scan.ts",
    "scan:quick": "tsx scripts/scan.ts --quick",
    "typecheck": "next typegen && tsc --noEmit",
    "sync:permissions": "tsx scripts/sync-permissions.ts",
    "sync:permissions:prod": "DOTENV_CONFIG_PATH=.env.prod tsx scripts/sync-permissions.ts",
    "fx:refresh": "tsx scripts/fx-refresh.ts",
    "test": "vitest run --passWithNoTests --project unit --project component",
    "test:watch": "vitest",
    "test:integration": "vitest run --passWithNoTests --project integration",
    "e2e": "E2E_BASE_URL=${E2E_BASE_URL:-https://mini-tavkil.yusufemin-dev.workers.dev} playwright test",
    "e2e:report": "playwright show-report",
    "cf:build": "opennextjs-cloudflare build && node scripts/strip-build-secrets.mjs",
    "cf:build:prod": "node scripts/build-cloudflare-prod.mjs",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build:prod && opennextjs-cloudflare deploy",
    "deploy:dev": "pnpm cf:build:prod && wrangler deploy --env dev",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare": "lefthook install",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=.env.prod drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "DOTENV_CONFIG_PATH=.env.prod drizzle-kit studio",
    "secrets:restore:prod": "node scripts/restore-secrets.mjs",
    "admin:build": "pnpm --filter mini-tavkil-admin build",
    "admin:deploy": "pnpm --filter mini-tavkil-admin deploy",
    "admin:deploy:dev": "pnpm --filter mini-tavkil-admin deploy:dev",
    "admin:typecheck": "pnpm --filter mini-tavkil-admin exec tsc -b --noEmit",
    "admin:lint": "pnpm --filter mini-tavkil-admin lint",
    "api:dev": "pnpm --filter mini-tavkil-api dev",
    "api:typecheck": "pnpm --filter mini-tavkil-api typecheck",
    "api:deploy": "pnpm --filter mini-tavkil-api deploy",
    "api:deploy:dev": "pnpm --filter mini-tavkil-api deploy:dev",
    "api:routes": "hono routes src/server/app.ts --plain"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@tavkil/shared": "workspace:*",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hono/cli": "1.0.0-rc.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.3",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.1"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.31.0",
      "@vitest/mocker": "^4.1.11",
      "brace-expansion@^1.0.0": "^1.1.20",
      "brace-expansion@^2.0.0": "^2.1.6",
      "brace-expansion@^4.0.0": "^5.0.12",
      "brace-expansion@^5.0.0": "^5.0.12",
      "deepmerge-ts": "^8.0.0",
      "esbuild": "^0.25.0",
      "fast-uri": "^3.1.8",
      "ip-address": "^10.7.1",
      "js-yaml": "^4.3.2",
      "katex": "^0.18.2",
      "mysql2": "^3.23.1",
      "postcss-selector-parser": "^7.1.6",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "sharp": "^0.35.5",
      "smol-toml": "^1.9.0",
      "source-map-js": "^1.2.2",
      "jsdom>undici": "^8.10.2",
      "miniflare>undici": "^8.10.2",
      "undici@^7.0.0": "^7.29.1",
      "undici@^8.0.0": "^8.10.2",
      "vitest": "^4.1.11"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
