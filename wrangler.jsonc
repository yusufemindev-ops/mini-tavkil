{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-tavkil",
  // Pinned: wrangler was once authenticated to the temsan account, which made the
  // R2 buckets look "not found". Pinning fails loudly instead of deploying elsewhere.
  "account_id": "0b90963dada5e65530f075206f214362",
  // Wraps OpenNext's generated worker to add a `scheduled` export — see worker.ts.
  "main": "worker.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",

    // Cloudflare serves static assets BEFORE the Worker runs. The admin SPA lives
    // in public/admin, so without this every /admin request was answered straight
    // from the asset store and Next's middleware never executed — the gate was
    // bypassed in production while working perfectly in `next dev`, which has no
    // asset layer. Deep links like /admin/products 404'd for the same reason:
    // there is no file at that path and the Worker never got asked.
    //
    // Routing these paths to the Worker first puts the auth check back in front,
    // and the catch-all handler at app/admin/[[...slug]] serves the shell (and
    // passes real asset requests back to this binding).
    "run_worker_first": ["/admin", "/admin/*"],
  },

  "observability": { "enabled": true },

  // ─── D1: the ISR tag cache ─────────────────────────────────────────────────
  // Without a tag cache OpenNext resolves `tagCache` to "dummy", which makes
  // `revalidatePath()` a SILENT no-op — an admin publishing a product would wait
  // out the full `revalidate` window (an hour) before the storefront showed it.
  // D1 is on the free plan and holds only tag→path rows, so this costs nothing.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "tavkil-tags",
      "database_id": "c37acd64-984d-461e-9987-1261ecf05ee4",
    },
  ],

  // ─── R2 ────────────────────────────────────────────────────────────────────
  // No S3 credentials anywhere: the bucket is a binding.
  // ONE bucket, no dev/preview variant — local dev writes to the real bucket
  // (`remote: true`), same as production. Single-environment by decision.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "tavkil-images",
      "remote": true,
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "tavkil-cache",
    },
  ],

  // ─── Cron ──────────────────────────────────────────────────────────────────
  // Workers have no long-lived process. The FX refresh that was a Nest
  // WORKER_MODE loop runs here instead. Handler: src/app/api/cron/fx/route.ts
  // Every 2 hours, not once a day. The handler no-ops if a refresh already
  // succeeded today, so this is "one success per day plus automatic retries
  // until it works" — a daily-only trigger would leave rates a full day stale
  // after a single bad morning. 12 invocations/day is well inside the free plan.
  "triggers": {
    "crons": ["0 */2 * * *"],
  },

  // The live domain. Declared here rather than added in the dashboard so the
  // deployment target is version-controlled and a fresh clone deploys to the same
  // place. `custom_domain` makes Cloudflare own the apex DNS record and issue the
  // certificate; it replaces whatever A records the zone had.
  //
  // `www` is a redirect handled at the DNS/Rules layer, not a second origin — two
  // hostnames serving identical content is a duplicate-content problem, and the
  // canonical tags all point at the apex.
  // `www` is here so the Worker receives it and `middleware.ts` can 308 it to the
  // apex. Without a route the hostname falls through to whatever DNS answers —
  // which is how www kept serving a Squarespace placeholder for a day after the
  // apex had moved.
  "routes": [
    { "pattern": "tavkil.com", "custom_domain": true },
    { "pattern": "www.tavkil.com", "custom_domain": true },
  ],

  // Do not let a deploy delete variables it does not know about.
  //
  // `wrangler deploy` defaults to `keep_vars: false`, which means it replaces the
  // Worker's entire variable set with whatever this file declares. This file
  // declares one variable and no secrets — so a deploy silently removed
  // DATABASE_URL, BETTER_AUTH_SECRET and the rest, and the site answered
  // `{"ok":false,"error":"DATABASE_URL is not set"}` while every prerendered page
  // carried on working perfectly. The failure is invisible until something tries
  // to reach the database.
  //
  // Secrets are restored with `pnpm exec node scripts/restore-secrets.mjs`.
  "keep_vars": true,

  "vars": {
    // Still false. Attaching the domain does not make the site indexable — this
    // is the only switch that does, and flipping it needs a rebuild because it is
    // baked into the prerendered HTML, robots.txt and the sitemap.
    "SITE_INDEXABLE": "false",
  },

  // Secrets are NOT listed here. Local: .dev.vars. Production: `wrangler secret put`.
  // DATABASE_URL, DIRECT_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, ADMIN_ALLOWLIST, TURNSTILE_SECRET_KEY,
  // INDEXNOW_API_KEY
}
